rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el usuario autenticado puede leer y escribir su propio perfil.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Personas: cualquier autenticado puede leer, crear y actualizar.
    // Solo ADMINISTRADOR puede eliminar (se verifica grupo en /users/{uid}).
    match /persons/{personId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grupo == 'ADMINISTRADOR';

      // Visitas (subcolección): mismo criterio que personas.
      match /visits/{visitId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
